   "source": [
    "Q.4 Write a program to find the number is grater than 100 or not.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "a5a87171",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "99 is a Not Grater than 100\n"
     ]
    }
   ],
   "source": [
    "num = int(input(\"Enter a number:\"))\n",
    "if num > 100:\n",
    "    print(num,\"is Grater than 100 \")\n",
    "else:\n",
    "    print(num,\"is a Not Grater than 100\")\n",
    "\n"
   ]
