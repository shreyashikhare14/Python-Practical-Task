   "source": [
    "10. Write a program to check whether a number is a single-digit number or not."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "e9fb7c33",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1 is a single digit number\n"
     ]
    }
   ],
   "source": [
    "number = int(input(\"Enter a Digit:\"))\n",
    "if number >= -9 and number <= 9:\n",
    "    print(number,\"is a single digit number\")\n",
    "else:\n",
    "    print(number,\"is a not single digit number\")\n"
   ]
  },
