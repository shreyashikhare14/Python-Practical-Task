   "source": [
    "37. Write a program to check whether a number lies between 10 and 50.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "2e2bb4fb",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1 does not lies Between 10 and 50.\n"
     ]
    }
   ],
   "source": [
    "number = int(input(\"Enter a number =\"))\n",
    "\n",
    "if number >=10 and number <=50:\n",
    "    print(number,\"lies Between 10 and 50.\")\n",
    "else:\n",
    "    print(number,\"does not lies Between 10 and 50.\")"
   ]
  }
