   "source": [
    "35. Write a program to check whether a number is divisible by 3 and 5.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "8c236596",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "30 is a Divisible by 3 and 5.\n"
     ]
    }
   ],
   "source": [
    "number = int(input(\"Enter a Number = \"))\n",
    "\n",
    "if number % 3 ==0 and number % 5==0:\n",
    "    print(number,\"is a Divisible by 3 and 5.\")\n",
    "else:\n",
    "    print(number,\"is a Not Divisible by 3 and 5.\")"
   ]
  },
