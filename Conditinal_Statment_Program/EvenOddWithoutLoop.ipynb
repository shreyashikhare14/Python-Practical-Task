    "Q.2 Write a program to calculate Even Odd Number without Loop"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "c1fbda9e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "11 is Odd number\n"
     ]
    }
   ],
   "source": [
    "num = int(input(\"Enter a number:\"))\n",
    "if num % 2 ==0:\n",
    "    print(num,\" is Even number\")\n",
    "else:\n",
    "    print(num , \"is Odd number\")"
   ]
