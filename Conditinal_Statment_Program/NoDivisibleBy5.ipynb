   "source": [
    "8. Write a program to check whether a number is divisible by 5 or not.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "7c958e04",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "123 is not divisible by 5\n"
     ]
    }
   ],
   "source": [
    "number = int(input(\"Enter a number =\"))\n",
    "\n",
    "if number % 5 ==0:\n",
    "    print(number,\"is divisible by 5\")\n",
    "else:\n",
    "    print(number,\"is not divisible by 5\")"
   ]
