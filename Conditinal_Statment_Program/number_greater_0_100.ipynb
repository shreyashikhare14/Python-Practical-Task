   "source": [
    "39. Write a program to check whether a number is greater than 0 and less than 100.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "5aafe5fa",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "888 is Not Greater than and Less than 100.\n"
     ]
    }
   ],
   "source": [
    "number =int(input(\"Enter a number =\"))\n",
    "\n",
    "if number >=0 and number <=100:\n",
    "    print(number,\"is Greater than and Less than 100.\")\n",
    "else:\n",
    "    print(number,\"is Not Greater than and Less than 100.\")"
   ]
  }
