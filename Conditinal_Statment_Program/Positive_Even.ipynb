   "source": [
    "31. Write a program to check whether a number is positive and even using nested if.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "15cbdeac",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "2 is Positive and Even Number.\n"
     ]
    }
   ],
   "source": [
    "number = int(input(\"Enter a Number:\"))\n",
    "\n",
    "if number >=0 and number % 2==0:\n",
    "    print(number, \"is Positive and Even Number.\")\n",
    "else:\n",
    "    print(number,\"is Not Positive and Even Number.\")"
   ]
  },
