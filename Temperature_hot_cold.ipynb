   "source": [
    "11. Write a program to check whether a temperature is hot (>30) or cold."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "c8b9ea20",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Temperature is hot\n"
     ]
    }
   ],
   "source": [
    "temperature = int(input(\"Enter a temperature = \"))\n",
    "\n",
    "if temperature >= 30:\n",
    "    print(\"Temperature is hot\")\n",
    "else:\n",
    "    print(\"Temperature is cold\")"
   ]
  },
