   "source": [
    "13. Write a program to check whether a number is zero or non-zero."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "a4d07366",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "This number is non-zero\n"
     ]
    }
   ],
   "source": [
    "number = int(input(\"Enter a number =\"))\n",
    "if number == 0:\n",
    "    print(\"This number is zero\")\n",
    "else:\n",
    "    print(\"This number is non-zero\")"
   ]
