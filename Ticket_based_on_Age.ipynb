   "source": [
    "20. Write a program to check ticket price based on age."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "e89a1159",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Your Ticket price is Full \n"
     ]
    }
   ],
   "source": [
    "age = int(input(\"Enter a Age =\"))\n",
    "\n",
    "if age >= 75:\n",
    "    print(\"Your Ticket Price is Free\")\n",
    "elif age >=12:\n",
    "    print(\"Your Ticket price is Full \")\n",
    "elif age >=0:\n",
    "    print(\"Your Ticket Price is Half \")\n",
    "else:\n",
    "    print(\"Invalid Age\")\n",
    "\n"
   ]
