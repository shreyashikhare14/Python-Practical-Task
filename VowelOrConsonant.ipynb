   ],
   "source": [
    "vowel= input(\"Enter a Vowel:\")\n",
    "if vowel == 'a'or vowel=='e'or vowel=='i' or vowel=='o' or vowel=='u':\n",
    "    print(vowel,\"is a vowel\")\n",
    "else:\n",
    "    print(vowel,\"character is consonant\")\n"
