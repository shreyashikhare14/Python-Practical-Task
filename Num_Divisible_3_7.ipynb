   "source": [
    "15. Write a program to check whether a number is divisible by both 3 and 7 or not."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "33424eef",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "21 is divisible by 3 and 7\n"
     ]
    }
   ],
   "source": [
    "num = int(input(\"Enter a number =\"))\n",
    "if num % 3==0 and num %  7 ==0:\n",
    "    print(num,\"is divisible by 3 and 7\")\n",
    "else:\n",
    "    print(num,\"not divisible by 3 and 7\")\n"
   ]
  },
